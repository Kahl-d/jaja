# Obsidian Bases view: every person in the job search (graph/people/<id>-person.md): prospects, the people in
# INBOX's table and the people named in research. Generated by `python3 scripts/build_graph.py`; the record is the
# prospect file (`record`) when there is one, and only its owning script changes it. Connections (who introduced
# whom, who refers to which role) are in each note's Connections section and in graph/CONNECTIONS.md.
filters:
  and:
    - file.inFolder("graph/people")
    - file.ext == "md"
properties:
  file.name:
    displayName: Note
  note.name:
    displayName: Person
  note.company:
    displayName: Company
  note.role:
    displayName: Role
  note.how_known:
    displayName: How you know them
  note.warmth:
    displayName: Warmth
  note.priority:
    displayName: Priority
  note.channel:
    displayName: Channel
  note.last_contact:
    displayName: Last contact
  note.wrote_last:
    displayName: Wrote last
  note.next_action:
    displayName: Next action
  note.next_action_at:
    displayName: Due
  note.record:
    displayName: Record
views:
  - type: table
    name: Needs a move
    filters:
      or:
        - wrote_last == "them"
        - next_action_at != "unknown"
    order:
      - name
      - company
      - priority
      - wrote_last
      - last_contact
      - next_action
      - next_action_at
      - channel
    sort:
      - property: priority
        direction: ASC
      - property: next_action_at
        direction: ASC
  - type: table
    name: All people
    order:
      - name
      - company
      - role
      - how_known
      - warmth
      - priority
      - channel
      - last_contact
      - wrote_last
      - next_action
      - next_action_at
      - record
    sort:
      - property: priority
        direction: ASC
      - property: last_contact
        direction: DESC
  - type: table
    name: No prospect record
    filters:
      and:
        - record == "none"
    order:
      - name
      - company
      - role
      - how_known
  - type: table
    name: By company
    groupBy:
      property: company
      direction: ASC
    order:
      - name
      - role
      - priority
      - warmth
      - last_contact
      - next_action_at
