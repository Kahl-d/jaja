<#
  ATS-hardened LaTeX resume: the fallback renderer behind `render_resume.py --engine latex`.
  Jinja2 with LaTeX-safe delimiters: double angle brackets print a value, angle-percent pairs
  hold statements, angle-hash pairs hold comments like this one.
  Every value arrives already escaped by render_resume.py (latex_inline); this file only lays
  out the same text structure as the RenderCV template: title and dates, then company and
  location, then bullets; one column; canonical headings; dates as `Aug 2023 - May 2026`.
#>
%-------------------------------------------------------------------------------
% Generated by scripts/render_resume.py from resumes/templates/latex-ats/resume.tex.j2.
% Edit the resume YAML or the template, not this file.
%-------------------------------------------------------------------------------
\documentclass[letterpaper,10pt]{article}
<< preamble >>
% PDF metadata: "<name>, Resume (<Lens>)" from facts.yaml (render_resume.py pdf_title); never a dash variant.
\hypersetup{pdftitle={<< pdf_title >>},pdfauthor={<< pdf_author >>}}
\begin{document}
% Insert REAL space glyphs between words: without this, macOS Preview/PDFKit
% (and some ATS parsers) drop interword spaces when copying text.
\ifdefined\pdfinterwordspaceon\pdfinterwordspaceon\fi

\begin{center}
  {\LARGE\bfseries << name >>}\\[2pt]
<% if headline %>
  {\small << headline >>}\\[1pt]
<% endif %>
  {\small << connections | join(' \\textbar{} ') >>}
\end{center}
\vspace{-6pt}
<% for section in sections %>

\section{<< section.title >>}
<% for block in section.blocks %>
<% if block.type == 'entry' %>
\entry{<< block.head >>}
<% for line in block.lines %>
<< line >>\par
<% endfor %>
<% if block.bullets %>
\begin{itemize}
<% for bullet in block.bullets %>
  \item << bullet >>
<% endfor %>
\end{itemize}
<% endif %>
\vspace{2pt}
<% elif block.type == 'list' %>
\begin{itemize}
<% for item in block.items %>
  \item << item >>
<% endfor %>
\end{itemize}
<% else %>
<< block.text >>\par
<% endif %>
<% endfor %>
<% endfor %>

\end{document}
